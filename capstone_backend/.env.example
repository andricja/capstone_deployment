# ============================================
# FERMs (Farm Equipment Rental Management System)
# Environment Configuration Template
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace placeholder values with actual credentials
# 3. NEVER commit .env file to git
# 4. Keep credentials secure (use password manager)
#
# ============================================

APP_NAME="FERMs"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# Database Configuration
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# ============================================
# Session Configuration
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com

# ============================================
# Cache & Queue Configuration
# ============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ============================================
# Redis Configuration (Optional)
# ============================================
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# Email Configuration
# ============================================
# For Gmail SMTP:
# 1. Enable 2-factor authentication
# 2. Generate app-specific password
# 3. Use that password in MAIL_PASSWORD
#
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="FERMs"

# ============================================
# AWS S3 Configuration (Optional)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# Laravel Sanctum Configuration
# ============================================
SANCTUM_STATEFUL_DOMAINS=your-domain.com,www.your-domain.com
FRONTEND_URL=https://your-domain.com

# ============================================
# Vite Configuration
# ============================================
VITE_APP_NAME="FERMs"

# ============================================
# Google OAuth Configuration
# ============================================
# Get credentials from: https://console.cloud.google.com
# Navigate to: APIs & Services → Credentials
# Create OAuth 2.0 Client ID if not exists
#
# IMPORTANT FOR LOCAL DEVELOPMENT:
# 1. Go to Google Cloud Console
# 2. Select your project
# 3. Go to: APIs & Services → Credentials
# 4. Add to "Authorized redirect URIs":
#    - http://localhost:8000/api/auth/google/callback (for local)
#    - https://your-domain.com/api/auth/google/callback (for production)
#
# Then replace the placeholders below with your actual credentials:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback
# ============================================

# ============================================
# Firebase Cloud Messaging (FCM) Configuration
# ============================================
# Get from: Firebase Console → Project Settings
# Navigate to: General → Your apps → Web app
#
FIREBASE_PROJECT_ID=your-firebase-project-id
# ============================================

# ============================================
# Additional Notes
# ============================================
#
# Security Checklist:
# [ ] Generated new APP_KEY
# [ ] Set APP_DEBUG=false for production
# [ ] Updated all database credentials
# [ ] Configured email settings (test sending)
# [ ] Set up Google OAuth redirect URI
# [ ] Verified Firebase project ID
# [ ] Updated domain in SESSION_DOMAIN and SANCTUM_STATEFUL_DOMAINS
# [ ] Never commit this file after filling in real values
#
# Deployment:
# 1. Upload .env to server (via SFTP/SSH)
# 2. Run: php artisan config:clear
# 3. Run: php artisan cache:clear
# 4. Test all authentication features
#
# ============================================
